              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/usage/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "{{subscriptionId}}",
                "usage",
                "summary"
              ]
            }
          }
        },
        {
          "name": "Delete Usage Log",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/usage/{{usageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subscriptions",
                "{{subscriptionId}}",
                "usage",
                "{{usageId}}"
              ]
            }
          }
        }
      ]
    },

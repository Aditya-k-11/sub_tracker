            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Watched a movie\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/usage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",

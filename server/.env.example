PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/subtrack
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

ENABLE_LOCAL_CRON=true
RENEWAL_REMINDER_WINDOW_DAYS=3
TRIAL_REMINDER_WINDOW_DAYS=2
WASTE_THRESHOLD_DAYS=30
MIN_SUBSCRIPTION_AGE_DAYS=14

# OAuth 2.0 Credentials (Phase 13)
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"
FRONTEND_URL="http://subtrack.local"
TOKEN_ENCRYPTION_KEY="your-32-byte-hex-key-here"
